[Unit]
Description=MOEX Radar · ежедневный подбор ручных вводов перед суточным прогоном
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-manual.service

# 15:30 UTC = 18:30 МСК — за полчаса до суточного прогона (16:05 UTC). Порядок важен:
# ручные ряды должны лечь в стор ДО того, как суточный соберёт витрину, иначе консенсус,
# закоммиченный днём, появится на панели только назавтра. Полчаса, а не десять минут:
# собственный дедлайн обвязки для этого режима — 1200 с, и даже патологически долгий
# прогон обязан отпустить общий замок до старта суточного (тот ждёт его лишь 240 с).
# Каждый день, включая выходные: заседание ЦБ приходится на пятницу, а консенсус и
# дивиденды правятся с телефона когда угодно — таймер лишь даёт конвейеру шанс
# посмотреть, стоит это миллисекунды чтения трёх файлов.
OnCalendar=*-*-* 15:30:00 UTC

# Суффикс UTC обязателен: иначе спецификация читается в поясе машины и порядок
# «сначала ручные, потом суточный» ломается при первой же смене tz.
AccuracySec=30s
RandomizedDelaySec=60
Persistent=true
# Persistent=true: пропущенный подбор — это день, когда панель показывает «консенсуса
# в данных нет» при заполненном inputs/consensus.yml.

[Install]
WantedBy=timers.target
