[Unit]
Description=MOEX Radar · реколибровка (сверка замороженных чисел с историей)
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
# Здесь oneshot законен, в отличие от сборочных юнитов: повторять реколибровку при
# отказе незачем. Она ничего не собирает и не публикует — читает стор и печатает дифф,
# и её пропуск стоит одного месяца ожидания, а не пропущенных данных.
Type=oneshot
User=dash
Group=dash
WorkingDirectory=/srv/dash/repo-842
EnvironmentFile=/usr/local/etc/moex-radar/env
Environment=PYTHONUNBUFFERED=1
# Опорные числа панели (статистика восьми ячеек, условные IC второго слоя, эталон
# walk-forward) заморожены в constants.py и в validation/data/, а история растёт
# каждый месяц. Дрейф идёт МОЛЧА: внеплановый аудит 12.08.2026 нашёл среднее токсичной
# ячейки −3,14% против замороженных −2,94% и hit 0,54, недостижимый при n=25. Юнит
# делает эту сверку регулярной; решение о составе ядра он не принимает и принять не
# может — автоматический отбор по свежей результативности проигран в walk-forward
# (REGIME.md §4: OOS IC −0,018 против +0,227).
SyslogIdentifier=moex-radar-recalibrate
ExecStart=/usr/local/sbin/moex-radar recalibrate
# Мостик тревог — как у пяти соседних юнитов. Без него падение реколибровки было бы
# НЕОТЛИЧИМО ОТ УСПЕХА: модель этой проверки — «молчит, значит расхождений нет», и
# умерший юнит молчит ровно так же. ExecStopPost, а не OnFailure: он выполняется всегда,
# поэтому из одного хука приходит и «сломалось», и «снова проходит».
ExecStopPost=-+/usr/local/sbin/dash-alert %n
# Дедлайн обвязки — 900 с, здесь потолок выше: юнит ждёт ещё и замок стора (240 с).
TimeoutStartSec=1500

# Песочница и лимиты — те же, что у сборочных юнитов: реколибровка строит ПОЛНУЮ
# панель (та же память, что суточный прогон), а машина общая — отказ этого юнита
# обязан оставаться его отказом, а не смертью sshd от глобального OOM.
StateDirectory=moex-radar
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
# Репозиторий пишется: обвязка делает git fetch/reset перед каждым прогоном.
ReadWritePaths=/srv/dash/repo-842
MemoryHigh=512M
MemoryMax=1G
Nice=10

[Install]
WantedBy=multi-user.target
