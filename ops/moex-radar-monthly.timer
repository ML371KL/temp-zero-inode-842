[Unit]
Description=MOEX Radar · ежедневный опрос месячных и декадных источников
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-monthly.service

# Каждый день, включая выходные: релизы ЦБ и Минфина выходят и в субботу, а решение
# «сегодня опрашивать или нет» принимает не таймер, а окна опроса в
# pipeline/lib/registry.py — таймер лишь даёт конвейеру шанс посмотреть.
# 09:00 UTC = 12:00 МСК: к полудню утренние публикации уже на сайтах, а до вечернего
# суточного прогона остаётся семь часов на повторы.
OnCalendar=*-*-* 09:00:00 UTC

# Разброс до десяти минут — вежливость к источникам (в один и тот же момент времени в
# cbr.ru и minfin.gov.ru ломиться незачем) и защита от совпадения с чужими таймерами.
# Для суточного опроса «до появления» десять минут не значат ничего.
RandomizedDelaySec=600
Persistent=true
# Пропущенный день опроса — это месячный релиз, увиденный на сутки позже; окна опроса
# перекрывают такие пропуски, но доигрывать после простоя всё равно дешевле, чем ждать.

[Install]
WantedBy=timers.target
