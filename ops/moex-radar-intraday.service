[Unit]
Description=MOEX Radar · витринный такт (свежие котировки, композит не пересчитывается)
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md
Wants=network-online.target
After=network-online.target
# Ограничитель обязан гасить ТОЛЬКО взбесившийся перезапуск и никогда — плановый такт.
# Считает systemd ВСЕ старты подряд, включая приходящие от таймера, а не одни лишь
# повторы по Restart=. Отсюда цена ошибки: в окне 900 с лежит ТРИ плановых такта
# (шаг 5 мин), и при burst=2 каждый третий отбивался с «Start request repeated too
# quickly» — за 13.08.2026 так молча пропало 73 такта из 169, включая закрывающий
# 21:00 UTC (00:00 МСК), потому что 20:50 и 20:55 выбирали лимит целиком. Обещанные
# в docs/LATENCY.md «≤6 мин» превращались в ≤15, а закрытие дня не снималось вовсе.
# Раньше это было верно: при шаге 15 мин в окно попадал один плановый старт.
# Теперь: 3 плановых + 3 повтора (RestartSec=60). Петля перезапусков даёт ~15 стартов
# за окно и по-прежнему упирается в потолок.
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
# Type=exec, а не oneshot: systemd отказывается загружать oneshot с Restart= отличным
# от no, а один повтор через минуту снимает половину сетевых морганий.
Type=exec
User=dash
Group=dash
WorkingDirectory=/srv/dash/repo-842
EnvironmentFile=/usr/local/etc/moex-radar/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/sbin/moex-radar intraday
Restart=on-failure
RestartSec=60
# 240 с ожидания замка + 300 с собственного дедлайна такта. Такт, переживший свой
# интервал, не имеет смысла: следующий уже стоит в очереди с более свежими данными.
RuntimeMaxSec=600
SyslogIdentifier=moex-radar-intraday

StateDirectory=moex-radar
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths=/srv/dash/repo-842

MemoryHigh=384M
MemoryMax=768M
Nice=10

# '-+' обязательно: '-' — падение мостика не красит прогон, '+' — под ProtectSystem
# мостик иначе не запишет маркер дедупа.
ExecStopPost=-+/usr/local/sbin/dash-alert %n
