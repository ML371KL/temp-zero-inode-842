[Unit]
Description=MOEX Radar · суточный прогон после закрытия сессий
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-daily.service

# 16:05 UTC = 19:05 МСК — через пятнадцать минут после закрытия основной сессии: к этому
# моменту ISS отдаёт итоговые закрытия и КБД, а официальный курс ЦБ на завтра уже
# опубликован. Это ГЛАВНЫЙ прогон дня: композит и машина состояний считаются по
# закрытиям (docs/ARCHITECTURE.md §1), интрадей их не двигает.
OnCalendar=Mon..Fri *-*-* 16:05:00 UTC
# 20:55 UTC = 23:55 МСК — добор после вечерней сессии. Лёгкий: досчитывает то, что
# доехало позже (поздние публикации ЦБ, вечерние закрытия).
OnCalendar=Mon..Fri *-*-* 20:55:00 UTC

# Суффикс UTC обязателен: без него спецификация читается в часовом поясе машины, и
# главный прогон дня уезжает на три часа при первой же смене tz.
AccuracySec=15s
Persistent=true
# Persistent=true, в отличие от витринного такта: пропущенный суточный прогон — это
# пропущенный день истории композита и состояний, а не пропущенная картинка. Машина,
# включённая после простоя, обязана его доиграть.

[Install]
WantedBy=timers.target
