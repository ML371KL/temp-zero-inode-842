[Unit]
Description=MOEX Radar · суточный прогон: после закрытия сессий и утром после торгового дня
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-daily.service

# 16:05 UTC = 19:05 МСК — через пятнадцать минут после закрытия основной сессии: к этому
# моменту ISS отдаёт итоговые закрытия и КБД, а официальный курс ЦБ на завтра уже
# опубликован. Это ГЛАВНЫЙ прогон дня: композит и машина состояний считаются по
# закрытиям (docs/ARCHITECTURE.md §1), интрадей их не двигает.
OnCalendar=Mon..Fri *-*-* 16:05:00 UTC
# 20:55 UTC = 23:55 МСК — добор после вечерней сессии. Лёгкий: досчитывает то, что
# доехало позже (поздние публикации ЦБ, вечерние закрытия).
OnCalendar=Mon..Fri *-*-* 20:55:00 UTC
# 04:30 UTC = 07:30 МСК, утро ПОСЛЕ торгового дня (вторник–суббота). Две причины
# (аудит 20.11.2026):
#   1) строку дня по индексу полной доходности, ценам акций TQBR, MCXSM и
#      корпоративным индексам биржа отдаёт ночью, позже прогона 20:55 UTC. Без
#      утреннего такта ширина рынка, малые компании и MCFTR всегда были на торговый
#      день старше, а пятничные значения появлялись в понедельник вечером (замер:
#      вечером 19.11 в сторе эти ряды кончались 18.11, в 05:37 UTC 20.11 биржа уже
#      отдавала 19.11);
#   2) страховка вечернего прогона: он приходит меньше чем через пять минут после
#      того, как биржа публикует строку дня по IMOEX. Опоздай биржа — и решение дня
#      молча уехало бы на сутки, а в пятницу — на трое.
# Суббота, а не понедельник: такт идёт после торгового дня, а не перед ним. До 07:00
# UTC витринных тактов нет, недельный понедельничный — в 07:05, так что замок стора
# утренний прогон ни с кем не делит.
OnCalendar=Tue..Sat *-*-* 04:30:00 UTC

# Суффикс UTC обязателен: без него спецификация читается в часовом поясе машины, и
# главный прогон дня уезжает на три часа при первой же смене tz.
AccuracySec=15s
Persistent=true
# Persistent=true, в отличие от витринного такта: пропущенный суточный прогон — это
# пропущенный день истории композита и состояний, а не пропущенная картинка. Машина,
# включённая после простоя, обязана его доиграть.

[Install]
WantedBy=timers.target
