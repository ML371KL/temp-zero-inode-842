[Unit]
Description=MOEX Radar · такт витрины каждые 5 минут в торговом окне
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-intraday.service

# 07:00–21:00 UTC = 10:00–00:00 МСК, будни: окно основной и вечерней сессий МосБиржи.
# Суффикс UTC обязателен — иначе systemd читает спецификацию в часовом поясе машины, и
# смена tz (или переезд на другой сервер) молча сдвигает всё окно на три часа.
# Список минут вместо шага записан намеренно: перечисление читается однозначно и не
# зависит от того, как конкретная версия systemd разбирает `0/5`.
#
# Шаг 5, а не 15, с 12.08.2026. Индексы Группы «Московская Биржа» отдаются бесплатно
# БЕЗ задержки (moex.com/ru/orders), поэтому шаг такта — единственное, что отделяло
# панель от рынка: было «до 15 мин + минута фронта», стало «до 5». Прогон занимает
# 4–6 с и три запроса из четырёх идут в один и тот же ISS, так что втрое чаще —
# это по-прежнему меньше одного запроса в секунду в среднем по часу.
OnCalendar=Mon..Fri *-*-* 07..20:00,05,10,15,20,25,30,35,40,45,50,55 UTC
# Закрывающий такт ровно в полночь по Москве: вечерняя сессия к этому моменту уже
# посчитана, и витрина уходит в ночь со свежими числами.
OnCalendar=Mon..Fri *-*-* 21:00:00 UTC

# Точность по умолчанию — минута; здесь она означала бы «где-то между 10:00 и 10:01».
# Для витрины это неважно, но ровные отметки в журнале сильно упрощают разбор.
AccuracySec=15s
# Небольшой разброс, чтобы такты не приходились на ту же секунду, что и чужие
# таймеры на этой машине.
RandomizedDelaySec=20
# Пропущенные такты НЕ доигрываются: догонять здесь нечего — такт всегда берёт текущее
# состояние рынка, а следующий и так через пять минут. С Persistent=true включённая
# после простоя машина получала бы залп «догоняющего» такта ровно в тот момент, когда
# она и так занята загрузкой.
Persistent=false

[Install]
WantedBy=timers.target
