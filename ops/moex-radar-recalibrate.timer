[Unit]
Description=MOEX Radar · реколибровка раз в месяц (говорит только когда есть что сказать)
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-recalibrate.service

# ПОЧЕМУ ЕЖЕМЕСЯЧНО, А НЕ РАЗ В КВАРТАЛ, хотя регламент §7 говорит про квартал.
# Считать дёшево (секунды), а ждать дорого: расхождение, появившееся в январе, при
# квартальном такте живёт на витрине до апреля. Поэтому СЧИТАЕМ каждый месяц, а
# ГОВОРИМ по-разному: тревога уходит сразу, рутинное «расхождений нет» — только в
# квартальные месяцы (ops/recalibrate.py: --notify auto). Так регламентный ритм
# сохранён для читателя, а отставание диагностики сокращено вчетверо.
#
# 5-е число: месячные ряды (ОРФР, ИПЦ, бюджет) к этому дню уже опубликованы за
# прошлый месяц, и сверка идёт по закрытому месяцу, а не по половине текущего.
#
# 21:30 UTC = 00:30 МСК — ПОСЛЕ всех тактов дня. Первая редакция стояла на 20:40 и
# попадала внутрь окна витринных тактов (Mon–Fri 07:00–20:55 каждые пять минут):
# столкновение не сломало бы ничего — flock развёл бы их, а интрадей честно пропустил
# бы такт, — но обмен «пропущенный такт витрины ради сверки, которая может подождать»
# невыгоден. Последний сборочный юнит дня стартует в 21:00, ему хватает минут.
OnCalendar=*-*-05 21:30:00 UTC

AccuracySec=1m
RandomizedDelaySec=300
# Persistent=true: пропущенная сверка — пропущенный месяц наблюдения за дрейфом.
# Машина, включённая после простоя, обязана её доиграть.
Persistent=true

[Install]
WantedBy=timers.target
