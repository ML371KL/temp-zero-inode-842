[Unit]
Description=MOEX Radar · недельный такт (среда после Росстата, понедельник после выходных)
Documentation=https://github.com/ML371KL/temp-zero-inode-842/blob/main/docs/ARCHITECTURE.md

[Timer]
Unit=moex-radar-weekly.service

# 07:05 UTC = 10:05 МСК, понедельник: гэп выходных по IMOEX2 (docs/ARCHITECTURE.md §4,
# «Выходные сессии/гэп — пн 10:05»). Ряд входит в MODES['weekly'] и в будни его тянет
# суточный прогон; здесь он ради утра понедельника, когда гэп и виден.
OnCalendar=Mon *-*-* 07:05:00 UTC
# 17:20 UTC = 20:20 МСК, среда: Росстат публикует «Об оценке ИПЦ» около 19:00 МСК,
# итоги аукционов ОФЗ — с 18:00 МСК. Час после суточного прогона (16:05 UTC), а не
# сразу за релизом: два прогона в одном сторе разводит flock с ожиданием 240 с, и
# такт, пришедший в середину суточного, просто не дождался бы замка и покраснел.
OnCalendar=Wed *-*-* 17:20:00 UTC
# 06:20 UTC = 09:20 МСК, четверг: добор. Релиз Росстата регулярно опаздывает
# (в самом расписании заложены «ретраи до 21:00»), а следующая законная попытка иначе
# только через неделю — ряд с недельным шагом пропущенную неделю не восстанавливает.
OnCalendar=Thu *-*-* 06:20:00 UTC

# Суффикс UTC обязателен: без него спецификация читается в часовом поясе машины, и
# такт уезжает на три часа при первой же смене tz.
AccuracySec=30s
# Разброс — вежливость к источникам: в минуту релиза в Росстат ломятся все.
RandomizedDelaySec=120
Persistent=true
# Persistent=true: пропущенный недельный такт — это пропущенная НЕДЕЛЯ ряда, а не
# пропущенная картинка. Машина, включённая после простоя, обязана его доиграть.

[Install]
WantedBy=timers.target
