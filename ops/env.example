# Окружение конвейера «MOEX Radar». Ставится как /usr/local/etc/moex-radar/env
# с правами 640 root:dash: юниты читают его через EnvironmentFile=, обвязка
# /usr/local/sbin/moex-radar — при запуске руками.
#
# ФОРМАТ. Файл читают ДВА разных парсера: systemd (EnvironmentFile=) и bash (`.` в
# обвязке). Общее подмножество узкое, и выходить за него нельзя:
#   * строки строго KEY=value, без `export` и без пробелов вокруг `=`;
#   * никаких $ПОДСТАНОВОК внутри значений — bash их раскроет, systemd оставит как
#     есть, и два способа запуска начнут работать по-разному;
#   * значения с пробелами — в кавычках.
#
# Файл НИКОГДА не перезаписывается установщиком: ops/install-vps.sh создаёт его из
# этого шаблона только если файла ещё нет. Здесь лежат секреты — в git попадает только
# шаблон.

# ---------------------------------------------------------------- бакет R2 (запись)
# Куда конвейер кладёт data.json, history/* и зеркало сырья raw/*. Тот же бакет читает
# страница — но читает через биндинг DATA в wrangler.toml, ключи ниже ей не нужны.

# Идентификатор аккаунта Cloudflare: из него собирается S3-эндпоинт
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Тот же, что CLOUDFLARE_ACCOUNT_ID
# в секретах репозитория.
R2_ACCOUNT_ID=

# Ключи S3-совместимого токена R2 (Cloudflare → R2 → Manage API tokens).
# Права нужны ровно «Object Read & Write» на один бакет: токен, умеющий больше,
# однажды сотрёт больше.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Имя бакета. Совпадает с bucket_name в wrangler.toml — иначе страница будет читать
# один бакет, а конвейер писать в другой, и оба будут «работать».
R2_BUCKET=moex-radar

# Хост S3-эндпоинта. Пусто = собирается из R2_ACCOUNT_ID. Заполнять только если бакет
# живёт за своим доменом или через прокси (pipeline/lib/r2.py).
R2_ENDPOINT_HOST=

# ------------------------------------------------------------- единственный писатель
# Лиз (docs/CONTRACT.md §5): в lease.json лежат роль писателя (vps|gha) и holder_id.
#
# Роль. Без неё пайплайн угадывает по переменной GITHUB_ACTIONS и на этой машине
# угадал бы верно — но право единственной записи не то, что оставляют на догадку
# рантайма (pipeline/lib/lease.py).
RADAR_WRITER=vps

# Идентификатор держателя. По нему в аварии видно, КАКАЯ машина держала перо; значение
# обязано быть уникальным для машины. Умолчание пайплайна — «роль:hostname», и оно
# рабочее, но безымянный hostname в чужом журнале ничего не объясняет.
RADAR_WRITER_ID=vps-hetzner

# TTL хартбита (90 мин) и таймаут HTTP зашиты в код (pipeline/lib/lease.py,
# pipeline/lib/http.py) и переменными окружения НЕ настраиваются. Это не упущение:
# оба числа согласованы с расписанием таймеров и с порогом, на котором краснеет фронт
# (STALE_AFTER_MINUTES = 150 мин), и менять их надо вместе, в коде, а не по одному
# в файле окружения на одной из машин.

# ------------------------------------------------------------------- рабочие каталоги
# Сырьё (raw/{series_id}.json), кэш и маркеры дедупа тревог. Юниты просят у systemd
# StateDirectory=moex-radar, то есть каталог создаётся и отдаётся пользователю dash
# автоматически; менять путь имеет смысл только при запуске без systemd.
STATE_DIR=/var/lib/moex-radar

# Ниже — переменные ОБВЯЗКИ (/usr/local/sbin/moex-radar). Конвейер их не читает.

# Рабочая копия репозитория, которую обвязка обновляет перед каждым прогоном.
REPO_DIR=/srv/dash/repo-842

# Интерпретатор. Нужен 3.12+ (в Ubuntu 24.04 это системный python3). Отдельного venv
# у конвейера нет: он на стандартной библиотеке.
PYTHON_BIN=/usr/bin/python3

# --------------------------------------------------------------------- уведомления
# Телеграм-бот для событийных тревог (docs/CONTRACT.md §6: смена ячейки, разворот ядра,
# решение ЦБ, санитарные). Пустой токен = уведомления выключены, конвейер работает
# молча — это законный режим, а не отказ.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------- проверки
# Адрес витрины со стороны читателя. Обвязка после суточного прогона смотрит его
# last-modified и пишет в журнал возраст: между «конвейер отработал» и «человек видит
# свежие числа» стоят лиз, R2 и край Cloudflare, и каждый умеет молчать.
PUBLIC_DATA_URL=https://tzi-842.pages.dev/data/data.json
