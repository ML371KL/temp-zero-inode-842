# Состояние конвейера. Сырьё, кэш и маркеры дедупа тревог живут в STATE_DIR, а не в
# git: источник правды для данных — бакет R2, репозиторий хранит только код и ручные
# вводы (inputs/). Данные в git означали бы коммит на каждый такт — четыре в час.
.state/
state/

# Снимки витрины, снятые с прода на разбор аварии. В дереве кода такой файл живёт
# ровно до первого прогона конвейера, после чего врёт — а читается как эталон («вот
# же данные, всё в порядке»). Один такой (live.json, 58 КБ) уже успел приехать в
# каждый чекаут VPS и раннера, ни на что при этом не влияя. Смотреть свежие данные —
# по адресу витрины или в STATE_DIR/out/data.json.
/live.json
*.snapshot.json

# Python: интерпретатор системный, зависимостей нет, но py_compile в CI и локальные
# прогоны оставляют кэш байт-кода.
__pycache__/
*.py[co]
.venv/
venv/

# Cloudflare/Node: в репозитории нет ни package.json, ни сборки — wrangler приезжает
# через npx и оставляет за собой локальное состояние.
.wrangler/
node_modules/
.dev.vars

# Мусор редакторов и файловых менеджеров.
.DS_Store
Thumbs.db
*.swp

# Логи локальных прогонов (пайплайн и предпросмотр).
*.log

# Снимки прода и выгрузки аудита — рабочие артефакты, а не исходники: на них
# нельзя опираться в проверках (данные меняются каждый прогон), и они уже дважды
# оказывались закоммиченными по невнимательности.
live*.json
audit_raw.json
